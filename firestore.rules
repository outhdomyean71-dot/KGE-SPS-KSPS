rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /school_info/{userId} {
      allow read, write: if true;
    }

    match /lessons/{lessonDocId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
